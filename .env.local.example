# Claude API (분석 엔진) - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# GitHub REST API - 선택 사항이지만 설정 시 rate limit이 완화됩니다.
# https://github.com/settings/tokens (레포 접근 권한 불필요, public_repo 스코프면 충분)
GITHUB_TOKEN=

# OG 이미지/메타데이터의 절대 URL 생성에 사용됩니다.
# 로컬 개발은 기본값(http://localhost:3000) 그대로 두고, 배포 시 실제 도메인으로 변경하세요.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
